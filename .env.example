# 자리표시자만 둔다. 실제 값은 비추적 파일 `.env.local`에만 넣는다. 공개(브라우저에 노출되는) 값만 이 저장소에 둔다.

# Supabase 공개 설정. 서버 전용 Secret Key·DB 접속 문자열은 이 저장소에 두지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Web Push 공개 키(VAPID public key). 비공개 키는 백엔드에만 둔다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# 사이트 메타데이터 (PWA 및 배포 URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
